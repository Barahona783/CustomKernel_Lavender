# Archivos de configuración locales y secretos
.config
.config.old

# Carpeta de salida de compilación y binarios
out/

# Archivos temporales, objetos y compilados del kernel
*.o
*.ko
*.cmd
*.d
*.su
*.tar.gz

# Credenciales o llaves privadas accidentales (por si acaso)
*.pem
*.key
id_rsa
